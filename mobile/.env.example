# ===========================================
# Google OAuth Configuration
# ===========================================
# The WEB Client ID from Google Cloud Console.
#
# IMPORTANT: For Expo AuthSession, you MUST use the WEB Client ID,
# even on mobile. Expo's auth proxy handles the OAuth flow via
# a web redirect, so the Web Client ID is required.
#
# Native Client IDs (Android/iOS) are only needed if you're using
# @react-native-google-signin/google-signin with a bare workflow.
#
# To create:
# 1. Go to Google Cloud Console > APIs & Services > Credentials
# 2. Create OAuth 2.0 Client ID of type "Web application"
# 3. Add redirect URI: https://auth.expo.io/@your-username/your-app-slug
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=your-web-client-id.apps.googleusercontent.com

# ===========================================
# API Configuration
# ===========================================
# URL of the backend Express server
EXPO_PUBLIC_API_URL=http://localhost:3001
