# ===========================================
# Google OAuth Configuration
# ===========================================
# The WEB Client ID from Google Cloud Console.
# IMPORTANT: Use the WEB client ID here, NOT the Android/iOS native client IDs.
# The Web Client ID is used for server-side token exchange.
# 
# To set up:
# 1. Go to https://console.cloud.google.com
# 2. Create or select a project
# 3. Navigate to APIs & Services > Credentials
# 4. Create an OAuth 2.0 Client ID of type "Web application"
# 5. Add your redirect URIs
# 6. Copy the Client ID and Client Secret below
GOOGLE_CLIENT_ID=your-web-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret

# Redirect URI — must match one registered in Google Cloud Console
# For Expo AuthSession, this will be the Expo auth proxy URL
REDIRECT_URI=https://auth.expo.io/@your-username/your-app-slug

# ===========================================
# JWT Configuration  
# ===========================================
# Secret key for signing JWT tokens. Use a strong random string in production.
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# ===========================================
# Server Configuration
# ===========================================
PORT=3001
